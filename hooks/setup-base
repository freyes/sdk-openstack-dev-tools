#!/bin/bash
set -e

echo "openstack-dev-tools: running setup-base..."

# ── Ensure universe component ──────────────────────────────────────────
apt-get update
apt-get install -y software-properties-common

# ── Add Ubuntu Cloud Archive tools PPA ──────────────────────────────────
add-apt-repository -y ppa:ubuntu-cloud-archive/tools
apt-get update

# ── Install shared base packages ───────────────────────────────────────
apt-get install -y \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    git \
    git-review \
    tox \
    python3-stestr \
    build-essential \
    jq \
    curl \
    wget \
    vim \
    libssl-dev \
    libffi-dev \
    libxml2-dev \
    libxslt1-dev \
    apache2-dev \
    mariadb-client \
    postgresql-client \
    memcached \
    tmux \
    openstack-pkg-tools \
    cloud-archive-utils

# ── Install OpenStack CLI via pip ──────────────────────────────────────
pip3 install --break-system-packages \
    openstacksdk \
    python-openstackclient

# ── Install snaps (best-effort — snapd may not be available) ──────────
install_snap() {
    local name="$1"
    local args="${2:-}"
    if command -v "$name" >/dev/null 2>&1; then
        echo "openstack-dev-tools: $name already installed, skipping"
        return 0
    fi
    # shellcheck disable=SC2086  # intentional word splitting for snap args
    if snap install "$name" $args 2>/dev/null; then
        echo "openstack-dev-tools: installed snap $name"
    else
        echo "WARN: openstack-dev-tools: snap $name install failed — snapd may not be available"
    fi
}

install_snap juju --classic
install_snap charmcraft --classic
install_snap kubectl --classic
install_snap microk8s --classic

# ── System-wide PATH configuration ─────────────────────────────────────
cat <<'EOF' > /etc/profile.d/openstack-dev.sh
# openstack-dev-tools SDK
PATH="$SDK/bin:$PATH"
EOF

# ── Create workspace directories ───────────────────────────────────────
sudo -iu workshop mkdir -p \
    /home/workshop/openstack \
    /home/workshop/charms

# ── Install pipx ───────────────────────────────────────────────────────
apt-get install -y pipx

# ── Install bindep via pipx ────────────────────────────────────────────
if ! pipx list --short | grep -q bindep; then
    sudo -iu workshop pipx install bindep
else
    echo "openstack-dev-tools: bindep already installed, skipping"
fi

# ── Start devpi at boot ─────────────────────────────────────────────────
if ! pipx list --short | grep -q devpi-server; then
    sudo -iu workshop pipx install devpi-server
else
    echo "openstack-dev-tools: devpi-server already installed, skipping"
fi

if ! pipx list --short | grep -q devpi-web; then
    sudo -iu workshop pipx install devpi-web
else
    echo "openstack-dev-tools: devpi-web already installed, skipping"
fi

# ── Initialize devpi serverdir (idempotent) ─────────────────────────────
if [ ! -f /home/workshop/.devpi/.nodeinfo ]; then
    sudo -iu workshop devpi-init --serverdir /home/workshop/.devpi
fi

# ── Configure devpi systemd service ─────────────────────────────────────
cat <<'EOF' > /etc/systemd/system/devpi.service
[Unit]
Description=Devpi Server
Requires=network-online.target
After=network-online.target

[Service]
Type=simple
Restart=on-success
ExecStart=/home/workshop/.local/bin/devpi-server --host 0.0.0.0 --port 3141 --serverdir /home/workshop/.devpi
User=workshop

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable devpi.service
systemctl start devpi.service

echo "openstack-dev-tools: setup-base complete."
